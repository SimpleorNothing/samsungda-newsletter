{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samsungda-newsletter",
  "main": "src/entry.js",
  "compatibility_date": "2025-06-01",
  "r2_buckets": [
    { "binding": "RESEARCH", "bucket_name": "samsungda-research" }
  ],
  // cron 3분할 — 무료 플랜의 "한 실행당 서브리퀘스트 50회" 상한 대응.
  //   30 21 * * *  = 06:30 KST  제작(gatherData·렌더·R2 저장) + 인사이트 갱신
  //   0  22 * * *  = 07:00 KST  저장본 발송 + 발송 리포트
  //   0  0  * * *  = 09:00 KST  헬스체크(리포트 부재 시 경보 + 자동 복구 발송)
  // 엔트리는 src/entry.js. 실제 cron 역할 분기는 기존 src/index.js의 scheduled(event.cron)을 그대로 위임한다.
  "triggers": {
    "crons": ["30 21 * * *", "0 22 * * *", "0 0 * * *"]
  },
  "vars": {
    "FROM": "기획 도구모음 <newsletter@samsungda.net>",
    "PUBLIC_URL": "https://samsungda-newsletter.cw120-park.workers.dev",
    "SEND_ENABLED": "true"
  },
  "observability": { "enabled": true }
}